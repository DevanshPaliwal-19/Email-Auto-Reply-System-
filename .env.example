# ============================================================
# Autonomous Email Intelligence Agent - Environment Variables
# ============================================================

# ── Ollama Configuration ───────────────────────────────────────
# Used by LangChain for Intent Detection & Draft Generation
# Ollama must be running locally (e.g., ollama run llama3.1)
OLLAMA_MODEL=llama3.1

# ── Gmail API Configuration ──────────────────────────────────
# OAuth 2.0 Credentials (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be saved after first login
GMAIL_TOKEN_PATH=token.json

# ── Backend Configuration ────────────────────────────────────
# Port where the FastAPI backend runs
PORT=8000
